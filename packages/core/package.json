{
  "name": "@switchkick/core",
  "version": "0.1.0",
  "description": "Pure routing policy for switchkick: decision inputs in, model and effort out.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/eased-tech/switchkick#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eased-tech/switchkick.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/eased-tech/switchkick/issues",
  "type": "module",
  "exports": {
    ".": {
      "switchkick-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
