{
  "name": "switchkick-monorepo",
  "private": true,
  "description": "Local proxy that routes OpenAI/Anthropic API traffic through OpenRouter, using Jev to pick the model per turn.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema": "UPDATE_SCHEMA=1 vitest run packages/proxy/test/schema.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "spike:fixtures": "node scripts/spikes/record-fixtures.ts",
    "spike:jev-latency": "node scripts/spikes/jev-latency.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "build:binaries": "node scripts/release/build-binaries.mjs",
    "smoke": "node scripts/release/smoke.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.18.0",
    "fast-check": "^4.10.2",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
